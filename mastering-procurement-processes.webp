equência aparecer?","audience.kicker":"Para quem é","audience.title":"Da compreensão profissional inicial à responsabilidade executiva pela decisão.","audience.text":"A camada pública serve leitores desde a compreensão inicial até à responsabilidade sénior. Liga procurement, supply chain, contratos, finanças, risco, compliance, auditoria, operações, ERP/MRP, IT e liderança executiva em torno de uma pergunta: a decisão pode ser defendida quando a consequência aparece?","start.kicker":"Começa aqui","start.title":"Escolhe a primeira decisão, não o catálogo inteiro.","start.text":"A loja pública está organizada como rota de entrada. Começa pela situação mais próxima do teu risco actual e sobe apenas quando a exposição da decisão o justificar.","start.path1.kicker":"Briefing de entrada","start.path1.title":"Compra de emergência, exposição de fornecedor ou falha de procurement","start.path1.text":"Para profissionais e gestores que precisam de uma lente pública rápida antes de a decisão se tornar difícil de defender.","start.path1.cta":"Começar com um briefing","start.path2.kicker":"Review premium","start.path2.title":"Uma decisão já importa","start.path2.text":"Para líderes perante uma exposição específica de fornecedor, contrato, continuidade ou governação que exige avaliação executiva escrita.","start.path2.cta":"Ver a review de €2.500","start.path3.kicker":"Acesso institucional","start.path3.title":"Capacidade ao nível da organização","start.path3.text":"Para instituições que ponderam licenciamento, software, integração ERP/MRP, dashboards, workflows ou deployment protegido.","start.path3.cta":"Pedir acesso formal","review.deliverable1.title":"Formato","review.deliverable1.text":"Avaliação executiva escrita em PDF.","review.deliverable2.title":"Prazo","review.deliverable2.text":"5 dias úteis após intake aceite e recepção da informação não confidencial acordada.","review.deliverable3.title":"Âmbito","review.deliverable3.text":"Uma decisão, uma exposição de fornecedor, uma posição contratual ou uma situação de risco de continuidade.","review.deliverable4.title":"Output","review.deliverable4.text":"Fragilidade da decisão, lacunas de evidência, ambiguidade de ownership, exposição e próximos passos escritos recomendados.","review.deliverable5.title":"Fronteira","review.deliverable5.text":"Sem direitos de implementação, software, formação, dashboards, APIs, ERP/MRP, ingestão AI/LLM ou uso organizacional.","review.intake":"Após a compra, o comprador envia a referência da encomenda e uma breve descrição não confidencial da situação para contact@ricardoferreira.ai ou licensing@ricardoferreira.ai.","books.access.title":"Acesso internacional aos livros","books.access.text":"Os livros técnicos estão ligados pela Amazon e pela rota oficial de autor. Leitores fora de Espanha podem usar a Amazon Author Page ou a loja Amazon local quando disponível.","books.access.cta":"Amazon Author Page","leadmagnet.kicker":"Nota conceptual gratuita","leadmagnet.title":"Queres a nota pública de entrada antes de comprar?","leadmagnet.text":"Pede a Decision Exposure Entry Note gratuita. É uma nota conceptual curta de camada pública para leitores que querem compreender exposição de fornecedor, lacunas de evidência e defensibilidade executiva antes de escolher um produto pago.","leadmagnet.cta":"Pedir nota gratuita","leadmagnet.linkedin":"Ligar no LinkedIn","hash.title":"Hash Canónico de Activo de Soberania","hash.date":"Data: 30 de Março de 2026"},"de":{"nav.home":"Start","nav.author":"Autor","nav.books":"Bücher","nav.store":"Store","nav.licensing":"Lizenzierung","nav.software":"Software","nav.fiction":"Fiktion","nav.contact":"Kontakt","hero.kicker":"Entscheidungsintegrität · Beschaffung · Versorgungssouveränität · institutionelle Verteidigungsfähigkeit","hero.title":"Zwei Werkgruppen.<br>Eine Disziplin der Konsequenz.","hero.lead":"Offizielle Plattform von Ricardo Manuel Machado Ferreira, Creator of the Ferreira Doctrine™ und Architect of Sovereign Decision Science™. Die institutionelle Hauptschicht behandelt Entscheidungsintegrität, Beschaffung, Versorgungssouveränität, Evidenz, Verantwortlichkeit und Verteidigungsfähigkeit; die literarische Schicht bleibt als separater Körper aus Fiktion, Erinnerung, Geheimnis und menschlicher Konsequenz erhalten.","cta.products":"Öffentliche Produkte ansehen","cta.licensing":"Institutioneller Zugang","cta.books":"Bücher ansehen","cta.store":"Store ansehen","cta.contact":"Kontakt","cta.buy":"Buy","cta.amazon":"Bei Amazon ansehen","cta.payhip":"Dieses Briefing kaufen","cta.bundle":"Dieses Bundle kaufen","cta.review":"Priorisierte schriftliche Review kaufen","cta.inquire":"Formelle Anfrage senden","entry.title":"Beginnen Sie mit öffentlichem Verständnis. Wechseln Sie erst bei schriftlichem Umfang zu formellem Zugang.","entry.text":"Der offizielle Weg führt von öffentlichem Verständnis zu Büchern und schriftlichen Produkten, von Produkten zu Bundles, von Bundles zu Premium Written Review und bei ernsthaftem institutionellem Interesse zu formellem Scoping, Lizenzierung und geschützter Unternehmensfähigkeit.","author.title":"Autor / redaktionelle Reichweite","author.text":"Ricardo Manuel Machado Ferreira ist Senior Procurement and Supply-Chain Executive, veröffentlichter Autor, Creator of the Ferreira Doctrine™ und Architect of Sovereign Decision Science™. Das technische Werk behandelt institutionelle Konsequenz. Das literarische Werk bewahrt Fiktion, Poesie, Geheimnis, Erinnerung und menschliche Konsequenz.","author.amor":"Amor und redaktionelle Reichweite","author.legacy":"Weitere literarische Werke","author.anti":"Nachweis von Anthologie-Beteiligungen","author.anti.text":"Anthologie-Beteiligungen werden nur als Autornachweis gezeigt. Sie werden hier nicht als Produkte dargestellt und es werden keine Anthologie-Links bereitgestellt.","books.title":"Technische und doktrinäre Werke","books.text":"Die öffentliche Buchschicht erklärt die Doktrin, Beschaffungs-Governance, Versorgungssouveränität und Entscheidungsintegrität. Der Kauf eines Buches gewährt keine Implementierungs-, Software-, Schulungs-, Derivat-, AI/LLM-Ingestions- oder Organisationsnutzungsrechte.","science.title":"Sovereign Decision Science™","science.text":"Sovereign Decision Science™ rahmt Entscheidungen als evidenztragende, ownership-tragende und konsequenztragende Handlungen. Sie gilt, wenn Procurement-, Lieferanten-, Vertrags-, Kontinuitäts- oder Executive-Entscheidungen Audit, Prüfung, Druck oder Scheitern überstehen müssen. Die öffentliche Schicht erklärt das Problem; geschützte Architektur, operative Methoden und institutionelle Implementierung erfordern formelle schriftliche Lizenzierung.","doctrine.title":"Ferreira Doctrine™","doctrine.text":"Die Ferreira Doctrine™ ist die geschützte doktrinale Architektur von Ricardo Manuel Machado Ferreira. Sie ist keine Ableitung bestehender Consulting-Frameworks; sie ist eine proprietäre Disziplin für Decision Integrity, Procurement Defensibility und institutionelle Konsequenz. Öffentliche Beschreibungen legen keine operativen Gates, Schwellenwerte, Scoring, Implementierungsmechaniken oder replizierbare interne Architektur offen.","store.title":"Store","store.text":"Öffentliche schriftliche Produkte für Executive Awareness, Beschaffungsexposition, Lieferantenrisiko, Verträge, Kontinuität, Governance und Entscheidungsverteidigungsfähigkeit.","store.bundles":"Shift Series Bundles","store.products":"Öffentliche schriftliche Produkte","store.notice":"Öffentlicher Kauf gewährt nur konzeptionellen schriftlichen Zugang. Er gewährt keine Rechte für institutionelle Implementierung, Schulung, Software, Dashboard, API, Workflow, ERP/MRP, AI/LLM-Ingestion, Derivate oder Organisationsnutzung.","review.title":"Executive Decision Defensibility Review","review.sub":"Priorisierte schriftliche Bewertung — 5 Werktage","review.text":"Premium Executive Written Review für eine Entscheidung, eine Lieferantenexposition, eine Vertragsposition oder eine Kontinuitätsrisikosituation. Lieferung als schriftliche PDF-Bewertung nach Eingang vereinbarter nicht vertraulicher Informationen.","review.price":"€2.500","review.scope1":"Entscheidungsfragilität","review.scope2":"Evidenzlücken","review.scope3":"Unklare Verantwortung","review.scope4":"Lieferanten- oder Vertragsexposition","review.scope5":"Governance-Schwächen","review.scope6":"Executive-Defensibility-Risiko","review.scope7":"Empfohlene nächste schriftliche Schritte","lic.title":"Institutioneller Zugang / Lizenzierung","lic.text":"Institutionelle Nutzung beginnt nur mit formeller schriftlicher Anfrage, schriftlichem Scoping und schriftlichem Angebot. Öffentlicher Zugang erklärt das Problem. Institutionelle Lizenzierung definiert die autorisierte Implementierungsgrenze.","lic.email":"licensing@ricardoferreira.ai","software.title":"Geschützte Unternehmenssoftware-Richtung","software.text":"Software, ERP/MRP-Integrationsschichten, Dashboards, APIs, Workflows und institutionelle Bereitstellung sind keine öffentlichen Produkte. Sie sind nur durch formelle schriftliche Lizenzierung, Scoping, Angebot und kontrollierte Implementierung verfügbar.","software.item1":"ERP/MRP-Integrationspfade","software.item2":"Dashboards und kontrollierte Ansichten","software.item3":"APIs und Workflow-Übersetzung","software.item4":"Vertraglich kontrollierte Zugangsgrenzen","fiction.title":"Fiktion und literarische Werke","fiction.text":"Ein separater literarischer Körper aus Thrillern, Fiktion, Geheimnis, Erinnerung, politischer Spannung, emotionaler Konsequenz und historischer Resonanz. Zwei Werkgruppen. Eine Disziplin der Konsequenz.","rights.title":"Rechte-Grenze","rights.text":"Öffentlicher Zugang begründet keine Implementierungsrechte. Keine Implementierungs-, Schulungs-, Software-, Dashboard-, API-, Workflow-, ERP/MRP-, AI/LLM-Ingestions-, Derivat-, Deployment- oder Organisationsnutzungsrechte werden ohne formelle schriftliche Lizenz des Rechteinhabers gewährt.","rights.list1":"Keine Implementierungs- oder Schulungsrechte","rights.list2":"Keine Software-, Dashboard-, API-, Workflow- oder ERP/MRP-Rechte","rights.list3":"Keine AI/LLM-Ingestion, Derivate oder Organisationsnutzung","rights.list4":"Geschützte Architektur nur durch Lizenz","rights.email":"rights@ricardoferreira.ai","contact.title":"Kontakt","contact.text":"Nutzen Sie die passende professionelle Adresse für allgemeinen Kontakt, institutionelle Lizenzierung oder Rechte/IP-Angelegenheiten.","contact.general":"Allgemeiner Kontakt","contact.licensing":"Institutionelle Lizenzierung / Software","contact.rights":"Rechte / IP / unautorisierte Nutzung","footer.boundary":"Öffentliche Bücher erklären die Doktrin. Schriftliche Produkte schärfen das Executive Awareness. Geschützte Architektur, Software, Implementierung, Schulung, Derivate, AI/LLM-Ingestion und organisatorische Bereitstellung erfordern formelle schriftliche Lizenzierung.","footer.official":"Offizielle Website","books.card":"Technisches/doktrinäres Buch der öffentlichen Schicht.","store.bundle.card":"Strukturiertes Public-Layer-Bundle für Executive Awareness.","store.product.card":"Schriftliches Public-Layer-Produkt für Entscheidungsexposition und Defensibility.","fiction.card":"Literarisches Werk von Ricardo Manuel Machado Ferreira.","author.link.desc":"Autornachweis / redaktioneller Eintrag.","hero.question":"Kann Ihre Organisation die Entscheidung verteidigen, nachdem die Konsequenz sichtbar wird?","audience.kicker":"Für wen","audience.title":"Von erster professioneller Orientierung bis zur Executive-Verantwortung für Entscheidungen.","audience.text":"Die öffentliche Schicht dient Lesern von erster Orientierung bis zur Senior Accountability. Sie verbindet Procurement, Supply Chain, Verträge, Finanzen, Risiko, Compliance, Audit, Operations, ERP/MRP, IT und Executive Leadership um eine Frage: Kann die Entscheidung verteidigt werden, wenn Konsequenz entsteht?","start.kicker":"Hier beginnen","start.title":"Wählen Sie die erste Entscheidung, nicht den gesamten Katalog.","start.text":"Der öffentliche Store ist als Einstiegsroute organisiert. Beginnen Sie mit der Situation, die Ihrem aktuellen Risiko am nächsten liegt, und gehen Sie nur weiter, wenn die Entscheidungsexposition es rechtfertigt.","start.path1.kicker":"Einstiegs-Briefing","start.path1.title":"Notkauf, Lieferantenexposition oder Procurement Failure","start.path1.text":"Für Fachkräfte und Manager, die eine schnelle öffentliche Perspektive benötigen, bevor eine Entscheidung schwer verteidigbar wird.","start.path1.cta":"Mit einem Briefing beginnen","start.path2.kicker":"Premium Review","start.path2.title":"Eine Entscheidung ist bereits wesentlich","start.path2.text":"Für Führungskräfte mit konkreter Lieferanten-, Vertrags-, Kontinuitäts- oder Governance-Exposition, die eine schriftliche Executive-Bewertung erfordert.","start.path2.cta":"€2.500 Review ansehen","start.path3.kicker":"Institutioneller Zugang","start.path3.title":"Fähigkeit auf Organisationsebene","start.path3.text":"Für Institutionen, die Lizenzierung, Software, ERP/MRP-Integration, Dashboards, Workflows oder geschütztes Deployment prüfen.","start.path3.cta":"Formellen Zugang anfragen","review.deliverable1.title":"Format","review.deliverable1.text":"Schriftliche Executive-Bewertung als PDF.","review.deliverable2.title":"Zeitplan","review.deliverable2.text":"5 Arbeitstage nach akzeptiertem Intake und Erhalt der vereinbarten nicht-vertraulichen Informationen.","review.deliverable3.title":"Umfang","review.deliverable3.text":"Eine Entscheidung, eine Lieferantenexposition, eine Vertragsposition oder eine Kontinuitätsrisiko-Situation.","review.deliverable4.title":"Output","review.deliverable4.text":"Entscheidungsfragilität, Evidenzlücken, Ownership-Ambiguität, Exposition und empfohlene nächste schriftliche Schritte.","review.deliverable5.title":"Grenze","review.deliverable5.text":"Keine Implementierungs-, Software-, Trainings-, Dashboard-, API-, ERP/MRP-, AI/LLM-Ingestions- oder Organisationsnutzungsrechte.","review.intake":"Nach dem Kauf sendet der Käufer die Bestellreferenz und eine kurze nicht-vertrauliche Beschreibung der Situation an contact@ricardoferreira.ai oder licensing@ricardoferreira.ai.","books.access.title":"Internationaler Buchzugang","books.access.text":"Die technischen Bücher sind über Amazon und die offizielle Autorenroute verlinkt. Leser außerhalb Spaniens können die Amazon Author Page oder ihren lokalen Amazon Store nutzen, sofern verfügbar.","books.access.cta":"Amazon Author Page","leadmagnet.kicker":"Kostenlose Konzeptnotiz","leadmagnet.title":"Möchten Sie die öffentliche Einstiegsnotiz vor dem Kauf?","leadmagnet.text":"Fordern Sie die kostenlose Decision Exposure Entry Note an. Sie ist eine kurze Public-Layer-Konzeptnotiz für Leser, die Lieferantenexposition, Evidenzlücken und Executive Defensibility verstehen möchten, bevor sie ein kostenpflichtiges Produkt wählen.","leadmagnet.cta":"Kostenlose Notiz per E-Mail anfordern","leadmagnet.linkedin":"Auf LinkedIn verbinden","hash.title":"Kanonischer Sovereignty Asset Hash","hash.date":"Datum: 30. März 2026"},"fr":{"nav.home":"Accueil","nav.author":"Auteur","nav.books":"Livres","nav.store":"Boutique","nav.licensing":"Licences","nav.software":"Logiciel","nav.fiction":"Fiction","nav.contact":"Contact","hero.kicker":"Intégrité décisionnelle · Procurement · Souveraineté d’approvisionnement · Défendabilité institutionnelle","hero.title":"Deux corps d’œuvre.<br>Une discipline de la conséquence.","hero.lead":"Plateforme officielle de Ricardo Manuel Machado Ferreira, Creator of the Ferreira Doctrine™ et Architect of Sovereign Decision Science™. La couche institutionnelle principale traite l’intégrité décisionnelle, le procurement, la souveraineté d’approvisionnement, la preuve, la responsabilité et la défendabilité; la couche littéraire reste préservée comme corps séparé de fiction, mémoire, secret et conséquence humaine.","cta.products":"Explorer les produits publics","cta.licensing":"Accès institutionnel","cta.books":"Voir les livres","cta.store":"Voir la boutique","cta.contact":"Contact","cta.buy":"Buy","cta.amazon":"Voir sur Amazon","cta.payhip":"Acheter ce briefing","cta.bundle":"Acheter ce bundle","cta.review":"Acheter la review écrite prioritaire","cta.inquire":"Envoyer une demande formelle","entry.title":"Commencer par la compréhension publique. Passer à l’accès formel uniquement lorsque le périmètre est écrit.","entry.text":"Le parcours officiel va de la compréhension publique aux livres et produits écrits, des produits aux bundles, des bundles à la revue écrite premium, puis, en cas d’intérêt institutionnel sérieux, au cadrage formel, à la licence et à la capacité d’entreprise protégée.","author.title":"Auteur / empreinte éditoriale","author.text":"Ricardo Manuel Machado Ferreira est senior procurement and supply-chain executive, auteur publié, Creator of the Ferreira Doctrine™ et Architect of Sovereign Decision Science™. L’œuvre technique traite la conséquence institutionnelle. L’œuvre littéraire préserve fiction, poésie, secret, mémoire et conséquence humaine.","author.amor":"Amor et empreinte éditoriale","author.legacy":"Autres œuvres littéraires","author.anti":"Registre de participation aux anthologies","author.anti.text":"Les participations aux anthologies sont montrées uniquement comme preuve d’auteur. Elles ne sont pas présentées ici comme produits et aucun lien vers les anthologies n’est fourni.","books.title":"Œuvres techniques et doctrinales","books.text":"La couche publique des livres explique la doctrine, la gouvernance du procurement, la souveraineté d’approvisionnement et l’intégrité décisionnelle. L’achat d’un livre n’accorde aucun droit d’implémentation, logiciel, formation, dérivé, ingestion AI/LLM ou usage organisationnel.","science.title":"Sovereign Decision Science™","science.text":"Sovereign Decision Science™ considère les décisions comme des actes porteurs de preuve, d’ownership et de conséquence. Elle s’applique lorsque des choix de procurement, fournisseur, contrat, continuité ou direction exécutive doivent survivre à l’audit, au scrutin, à la pression ou à l’échec. La couche publique explique le problème; l’architecture protégée, les méthodes opérationnelles et l’implémentation institutionnelle exigent une licence formelle écrite.","doctrine.title":"Ferreira Doctrine™","doctrine.text":"La Ferreira Doctrine™ est l’architecture doctrinale protégée créée par Ricardo Manuel Machado Ferreira. Elle n’est pas dérivée de frameworks de conseil existants; c’est une discipline propriétaire d’intégrité décisionnelle, de défendabilité procurement et de conséquence institutionnelle. Les descriptions publiques ne divulguent pas gates opérationnels, seuils, scoring, mécaniques d’implémentation ou architecture interne réplicable.","store.title":"Boutique","store.text":"Produits écrits de couche publique pour conscience exécutive, exposition procurement, risque fournisseur, contrats, continuité, gouvernance et défendabilité décisionnelle.","store.bundles":"Bundles Shift Series","store.products":"Produits écrits publics","store.notice":"L’achat public fournit uniquement un accès conceptuel écrit. Il n’accorde aucun droit d’implémentation institutionnelle, formation, logiciel, dashboard, API, workflow, ERP/MRP, ingestion AI/LLM, dérivé ou usage organisationnel.","review.title":"Executive Decision Defensibility Review","review.sub":"Évaluation écrite prioritaire — 5 jours ouvrables","review.text":"Revue exécutive écrite premium pour une décision, une exposition fournisseur, une position contractuelle ou une situation de risque de continuité. Livraison sous forme d’évaluation PDF écrite après réception des informations non confidentielles convenues.","review.price":"2 500 €","review.scope1":"Fragilité décisionnelle","review.scope2":"Lacunes de preuve","review.scope3":"Ambiguïté de responsabilité","review.scope4":"Exposition fournisseur ou contrat","review.scope5":"Faiblesses de gouvernance","review.scope6":"Risque de défendabilité exécutive","review.scope7":"Prochaines étapes écrites recommandées","lic.title":"Accès institutionnel / licences","lic.text":"L’usage institutionnel commence uniquement par une demande formelle écrite, un cadrage écrit et une proposition écrite. L’accès public explique le problème. La licence institutionnelle définit la frontière d’implémentation autorisée.","lic.email":"licensing@ricardoferreira.ai","software.title":"Direction logiciel d’entreprise protégé","software.text":"Logiciel, couches d’intégration ERP/MRP, dashboards, APIs, workflows et déploiement institutionnel ne sont pas des produits publics. Ils sont disponibles uniquement par licence formelle écrite, cadrage, devis et implémentation contrôlée.","software.item1":"Parcours d’intégration ERP/MRP","software.item2":"Dashboards et vues contrôlées","software.item3":"APIs et traduction de workflows","software.item4":"Frontières d’accès contrôlées par contrat","fiction.title":"Fiction et œuvres littéraires","fiction.text":"Un corps littéraire séparé de thrillers, fiction, secret, mémoire, tension politique, conséquence émotionnelle et résonance historique. Deux corps d’œuvre. Une discipline de la conséquence.","rights.title":"Frontière des droits","rights.text":"L’accès public ne constitue pas des droits d’implémentation. Aucun droit d’implémentation, formation, logiciel, dashboard, API, workflow, ERP/MRP, ingestion AI/LLM, dérivé, déploiement ou usage organisationnel n’est accordé sans licence formelle écrite du titulaire des droits.","rights.list1":"Aucun droit d’implémentation ou formation","rights.list2":"Aucun droit logiciel, dashboard, API, workflow ou ERP/MRP","rights.list3":"Aucune ingestion AI/LLM, dérivé ou usage organisationnel","rights.list4":"Architecture protégée uniquement sous licence","rights.email":"rights@ricardoferreira.ai","contact.title":"Contact","contact.text":"Utilisez l’adresse professionnelle appropriée pour le contact général, les licences institutionnelles ou les questions de droits/IP.","contact.general":"Contact général","contact.licensing":"Licences institutionnelles / logiciel","contact.rights":"Droits / IP / usage non autorisé","footer.boundary":"Les livres publics expliquent la doctrine. Les produits écrits affinent la conscience exécutive. Architecture protégée, logiciel, implémentation, formation, usage dérivé, ingestion AI/LLM et déploiement organisationnel exigent une licence formelle écrite.","footer.official":"Site officiel","books.card":"Livre technique/doctrinal de couche publique.","store.bundle.card":"Bundle structuré de couche publique pour conscience exécutive.","store.product.card":"Produit écrit de couche publique pour exposition décisionnelle et défendabilité.","fiction.card":"Œuvre littéraire de Ricardo Manuel Machado Ferreira.","author.link.desc":"Preuve d’auteur / fiche éditoriale.","hero.question":"Votre organisation peut-elle défendre la décision après l’apparition de la conséquence ?","audience.kicker":"Pour qui","audience.title":"De la sensibilisation professionnelle initiale à la responsabilité exécutive de la décision.","audience.text":"La couche publique sert les lecteurs depuis la première compréhension jusqu’à la responsabilité senior. Elle relie procurement, supply chain, contrats, finance, risque, compliance, audit, opérations, ERP/MRP, IT et direction exécutive autour d’une question : la décision peut-elle être défendue lorsque la conséquence apparaît ?","start.kicker":"Commencer ici","start.title":"Choisissez la première décision, pas tout le catalogue.","start.text":"La boutique publique est organisée comme route d’entrée. Commencez par la situation la plus proche de votre risque actuel, puis montez uniquement lorsque l’exposition décisionnelle le justifie.","start.path1.kicker":"Briefing d’entrée","start.path1.title":"Achat d’urgence, exposition fournisseur ou échec procurement","start.path1.text":"Pour les praticiens et managers qui ont besoin d’une lecture publique rapide avant qu’une décision devienne difficile à défendre.","start.path1.cta":"Commencer par un briefing","start.path2.kicker":"Review premium","start.path2.title":"Une décision compte déjà","start.path2.text":"Pour les dirigeants confrontés à une exposition fournisseur, contrat, continuité ou gouvernance nécessitant une évaluation exécutive écrite.","start.path2.cta":"Voir la review à 2 500 €","start.path3.kicker":"Accès institutionnel","start.path3.title":"Capacité au niveau organisationnel","start.path3.text":"Pour les institutions envisageant licence, logiciel, intégration ERP/MRP, dashboards, workflows ou déploiement protégé.","start.path3.cta":"Demander un accès formel","review.deliverable1.title":"Format","review.deliverable1.text":"Évaluation exécutive écrite en PDF.","review.deliverable2.title":"Délai","review.deliverable2.text":"5 jours ouvrables après intake accepté et réception des informations non confidentielles convenues.","review.deliverable3.title":"Périmètre","review.deliverable3.text":"Une décision, une exposition fournisseur, une position contractuelle ou une situation de risque de continuité.","review.deliverable4.title":"Output","review.deliverable4.text":"Fragilité décisionnelle, lacunes de preuve, ambiguïté d’ownership, exposition et prochaines étapes écrites recommandées.","review.deliverable5.title":"Frontière","review.deliverable5.text":"Aucun droit d’implémentation, logiciel, formation, dashboards, APIs, ERP/MRP, ingestion AI/LLM ou usage organisationnel.","review.intake":"Après achat, l’acheteur envoie la référence de commande et une courte description non confidentielle de la situation à contact@ricardoferreira.ai ou licensing@ricardoferreira.ai.","books.access.title":"Accès international aux livres","books.access.text":"Les livres techniques sont liés par Amazon et la route officielle d’auteur. Les lecteurs hors Espagne peuvent utiliser l’Amazon Author Page ou leur boutique Amazon locale lorsqu’elle est disponible.","books.access.cta":"Amazon Author Page","leadmagnet.kicker":"Note conceptuelle gratuite","leadmagnet.title":"Vous voulez la note publique d’entrée avant d’acheter ?","leadmagnet.text":"Demandez la Decision Exposure Entry Note gratuite. Il s’agit d’une courte note conceptuelle de couche publique pour comprendre l’exposition fournisseur, les lacunes de preuve et la défendabilité exécutive avant de choisir un produit payant.","leadmagnet.cta":"Demander la note gratuite par email","leadmagnet.linkedin":"Se connecter sur LinkedIn","hash.title":"Hash canonique d’actif de souveraineté","hash.date":"Date : 30 mars 2026"}};
const root=document.documentElement;
const langButtons=[...document.querySelectorAll('[data-lang]')];
function setLang(lang){
  const dict=RF_TRANSLATIONS[lang]||RF_TRANSLATIONS.en;
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const key=el.getAttribute('data-i18n');
    if(dict[key]) el.innerHTML=dict[key];
  });
  root.lang=lang;
  langButtons.forEach(btn=>btn.classList.toggle('active',btn.dataset.lang===lang));
  try{localStorage.setItem('rf_lang',lang);}catch(e){}
}
langButtons.forEach(btn=>btn.addEventListener('click',()=>setLang(btn.dataset.lang)));
setLang((()=>{try{return localStorage.getItem('rf_lang')||'en';}catch(e){return 'en';}})());
const toggle=document.querySelector('.menu-toggle');
const nav=document.getElementById('site-nav');
if(toggle&&nav){toggle.addEventListener('click',()=>{const open=nav.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');toggle.setAttribute('aria-expanded','false');}));}
</script>

