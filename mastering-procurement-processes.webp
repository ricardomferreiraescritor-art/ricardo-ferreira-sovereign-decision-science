<section class="decision-series" id="decision-blind-spot-series" aria-labelledby="decision-series-title">
  <div class="decision-series-shell">
    <div class="decision-series-head">
      <div>
        <p class="eyebrow" data-i18n="dbs.kicker">New Public-Layer Entry Route</p>
        <h2 id="decision-series-title" data-i18n="dbs.title">The Decision Blind Spot Series™</h2>
        <p data-i18n="dbs.lead">Start with a tool the market already trusts. See where it stops. Move into the missing decision question without receiving protected formulas, scoring, thresholds or implementation architecture.</p>
      </div>
